# ── 공통 ──────────────────────────────────────────────
NODE_ENV=development
# Supabase 를 쓸 때는 반드시 풀러(pooler.supabase.com)를 거친다.
# db.<ref>.supabase.co 직결 주소는 2024년부터 IPv6 전용이라 Vercel 에서 닿지 않는다.
#
#   DATABASE_URL  transaction 모드 6543 — 앱 런타임. pgbouncer=true 필수
#   DIRECT_URL    session 모드 5432 — 마이그레이션 전용
#
# 사용자명은 postgres 가 아니라 postgres.<project-ref> 다.
DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.REF:PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"
REDIS_URL="redis://localhost:6379"

# ── 인증 ──────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me"          # access 30분
JWT_REFRESH_SECRET="change-me"         # refresh 30일
MAGIC_LINK_SECRET="change-me"          # 학생 매직링크 (비밀번호 없음)

# ── 학생 이메일 보호 (09번 문서) ───────────────────────
# email_hash = sha256(lower(email) || EMAIL_HASH_PEPPER)
EMAIL_HASH_PEPPER="change-me"
EMAIL_ENC_KEY="base64:change-me"       # AES-256-GCM 32바이트

# ── 스토리지 · CDN (R2) ───────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hangyeol-assets
CDN_BASE_URL="https://cdn.hangyeol.app"
ASSET_SIGN_SECRET="change-me"
ASSET_URL_TTL_SEC=300                  # 서명 URL 300초

# ── 결제 (PG 빌링키. 카드번호는 절대 보관하지 않는다) ──
PG_API_KEY=
PG_WEBHOOK_SECRET=

# ── 메일 ──────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM="noreply@hangyeol.app"

# ── 종량과금 가드레일 (10번 문서 §4) ───────────────────
DAILY_LLM_CAP=20                       # 학생당 1일 LLM 호출 상한
DAILY_DRILL_MINUTES=15
ALLOW_RUNTIME_TTS=false                # production 에서 true 금지

# ── 학생 앱 (화이트라벨) ─────────────────────────────
NOTE_BASE_URL="http://localhost:3001"

# ── 배치 (Vercel Cron) ───────────────────────────────
CRON_SECRET="change-me"

# ── 화자 8명 (HVPT 필수 요건) ─────────────────────────
# tools/tts-batch 의 TALKER_VOICES 에 제공자별 음성 ID 8개를 채운다.
# 비워 두면 배치가 실행되지 않는다 — 임의로 정하면 전량 재생성해야 한다.
TTS_PROVIDER=
TTS_API_KEY=
